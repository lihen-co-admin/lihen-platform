{
  "name": "lihen-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @lihen/control-center dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run packages",
    "test:architecture": "vitest run tests/architecture",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "images:cutover:dry-run": "node tooling/cutover-web-images-v1.mjs",
    "images:cutover:dev": "node tooling/cutover-web-images-v1.mjs --execute",
    "test:e2e:storefront": "playwright test -c playwright.storefront.config.ts",
    "test:e2e:all": "pnpm test:e2e && pnpm test:e2e:storefront",
    "check:storefront:release-env": "node tooling/validate-storefront-release-env.mjs",
    "check:storefront:dist": "node tooling/validate-storefront-dist.mjs",
    "build:storefront:release": "pnpm check:storefront:release-env && pnpm --filter @lihen/storefront build && pnpm check:storefront:dist",
    "prepare:storefront:release-candidate": "node tooling/prepare-storefront-release-candidate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "type": "module"
}
