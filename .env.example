# Local isolated mode by default.
VITE_PRODUCT_READ_SOURCE=memory
VITE_AUTH_MODE=disabled
VITE_DEV_ALLOW_BOOTSTRAP_SIGNUP=false

# Browser-safe Supabase DEV variables. Required when source/auth uses Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

PUBLIC_STORE_URL=
NODE_ENV=development

# SERVER ONLY — do not expose to browser bundles
# SUPABASE_SERVICE_ROLE_KEY=

# Product Master controlled capabilities
VITE_PRODUCT_WRITE_MODE=blocked
VITE_PRODUCT_UPDATE_WRITE_MODE=blocked
VITE_PRODUCT_PRICE_WRITE_MODE=blocked
VITE_PRODUCT_PRICE_HISTORY_READ_MODE=blocked
VITE_PRODUCT_IMAGES_READ_MODE=blocked
VITE_PRODUCT_IMAGE_WRITE_MODE=blocked

# Operational controlled capabilities
VITE_INVENTORY_WRITE_MODE=blocked
VITE_SUPPLIER_WRITE_MODE=blocked
VITE_PURCHASE_WRITE_MODE=blocked
VITE_ORDER_WRITE_MODE=blocked
VITE_SALE_WRITE_MODE=blocked
VITE_FINANCE_WRITE_MODE=blocked

# Intelligence / publishing administration
VITE_VISUAL_INTELLIGENCE_MODE=blocked
VITE_PUBLIC_HUB_MODE=blocked

# SERVER ONLY — tooling/cutovers; do not expose these values to browser bundles
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
